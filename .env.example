# ─────────────────────────────────────────────────────────────
#  Clés secrètes du bot de veille IA
#  Copie ce fichier en `.env` pour tester en local :  cp .env.example .env
#  (En production, ces valeurs vivent dans les "Secrets" GitHub Actions.)
# ─────────────────────────────────────────────────────────────

# Clé API Claude (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Clé de l'API tierce qui récupère les tweets (https://twitterapi.io)
TWITTERAPI_IO_KEY=...

# Token du bot Telegram (donné par @BotFather quand tu crées ton bot)
TELEGRAM_BOT_TOKEN=123456:ABC...

# Identifiant du canal/chat où publier.
#  - Canal public : @mon_canal_de_veille
#  - Canal/groupe privé : un nombre négatif, ex. -1001234567890
TELEGRAM_CHAT_ID=@mon_canal_de_veille
